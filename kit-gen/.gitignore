# Dữ liệu thử cục bộ — repo chỉ giữ bộ công cụ trắng (mẫu styles: webapp/src/__tests__/fixtures/styles.example.json)
nohup.out
teams/*
!teams/easy-install/
!teams/easy-install/**
!teams/split-easy-install/
!teams/split-easy-install/**
!teams/easy-install-guide/
!teams/easy-install-guide/**
dist/
# Ảnh thử nghiệm được giữ cục bộ; chỉ force-add mốc đã chọn để làm tài liệu.
experiments/

# Vệ sinh secret (architecture §4.4-6) — không bao giờ commit dữ liệu/credential máy cá nhân
.kitgen/
auth.json
*.env
.env
.env.*
config.toml
KitGen/

# ── NGOẠI LỆ: FIXTURE GOLDEN CỦA ENGINE JS ───────────────────────────────────
# `raw/`, `kits/`, `styles.json` ở trên là DỮ LIỆU CỤC BỘ của một lượt gen thật và
# không bao giờ được commit. Nhưng fixture golden (`agent/test-fixtures/engine-*`)
# CỐ Ý mang đúng ba cái tên ấy: nó là bản chụp một thư mục project thật để bản JS
# chạy trên đúng bố cục mà `slice.py` chạy. Đổi tên trong fixture là để test chạy
# trên một bố cục không ai dùng — đúng loại "nhánh mặc định không ai đi".
!agent/test-fixtures/**/raw/
!agent/test-fixtures/**/raw/**
!agent/test-fixtures/**/kits/
!agent/test-fixtures/**/kits/**
!agent/test-fixtures/**/styles.json
# `prompts/` và `logs/` cũng vậy: golden của bộ lắp prompt LÀ nội dung thư mục
# `prompts/` mà gen.sh ghi ra (.txt · .att · .refs · .fullbleed). Thiếu ngoại lệ này
# thì `git add` nuốt im toàn bộ mốc đối chứng và bộ ca so byte không có gì để so.
!agent/test-fixtures/**/prompts/
!agent/test-fixtures/**/prompts/**
!agent/test-fixtures/**/logs/
!agent/test-fixtures/**/logs/**
