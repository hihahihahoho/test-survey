#!/usr/bin/env bash
set -eu
HOME_DIR="${KITGEN_HOME:-$HOME/.kitgen}"
CONFIG="$HOME_DIR/config.env"
[ -f "$CONFIG" ] && . "$CONFIG"
SOURCE="${KITGEN_SOURCE:-$HOME_DIR/current}"
[ -d "$SOURCE" ] && SOURCE="$(CDPATH= cd -- "$SOURCE" && pwd -P)"
WORKSPACE="${KITGEN_WORKSPACE:-$HOME/KitGen}"
PORT="${KITGEN_PORT:-8765}"
ORIGIN="${KITGEN_ORIGIN:-http://127.0.0.1:$PORT}"
NODE="${KITGEN_NODE:-$(command -v node 2>/dev/null || true)}"
CODEX_BIN="${KITGEN_CODEX_BIN:-$(command -v codex 2>/dev/null || true)}"
# LỚP PHÒNG THỦ CHO config.env ĐỜI CŨ (sự cố 14/08, hỏng 100% lượt gen).
#
# PATH của agent được dựng bằng `dirname "$CODEX_BIN"`, còn engine gọi `codex` TRẦN.
# Hợp đồng ngầm đó chỉ đúng khi CODEX_BIN có TÊN là `codex`. install.sh 2.1.19 ghi
# `.../@openai/codex/bin/codex.js` ⇒ thư mục đưa vào PATH không có file nào tên `codex`
# ⇒ rc=127 cho mọi job, UI báo "chạy xong nhưng ảnh không được ghi".
#
# install.sh mới đã ghi đúng, nhưng máy đang cài bản cũ chỉ nạp bin/kitgen mới sau khi
# update — mà update thì lại cần gen chạy được để người dùng còn tin. Nên tự chữa ở đây:
# ưu tiên file `codex` nằm cạnh, không có thì dựng shim của riêng KitGen. Im lặng khi
# không ghi được (ổ đĩa chỉ đọc): tệ nhất là giữ nguyên hành vi cũ, không làm hỏng thêm.
ensure_codex_name() {
  [ -n "$CODEX_BIN" ] || return 0
  [ "$(basename "$CODEX_BIN")" != codex ] || return 0
  sibling="$(dirname "$CODEX_BIN")/codex"
  if [ -x "$sibling" ]; then CODEX_BIN="$sibling"; return 0; fi
  shim="$HOME_DIR/tools/bin/codex"
  if [ ! -x "$shim" ] || ! grep -qsF -- "$CODEX_BIN" "$shim"; then
    mkdir -p "$HOME_DIR/tools/bin" 2>/dev/null || return 0
    case "$CODEX_BIN" in
      *.js|*.mjs|*.cjs) printf '#!/bin/sh\nexec "%s" "%s" "$@"\n' "$NODE" "$CODEX_BIN" > "$shim" 2>/dev/null || return 0 ;;
      *)                printf '#!/bin/sh\nexec "%s" "$@"\n' "$CODEX_BIN" > "$shim" 2>/dev/null || return 0 ;;
    esac
    chmod +x "$shim" 2>/dev/null || return 0
  fi
  CODEX_BIN="$shim"
}
agent_cmd() {
  [ -n "$NODE" ] || { echo "KitGen: Node runtime not found. Run install.sh again." >&2; exit 1; }
  ensure_codex_name
  NODE_DIR="$(dirname "$NODE")"
  CODEX_DIR="$(dirname "$CODEX_BIN")"
  exec env PATH="$WORKSPACE/.venv/bin:$NODE_DIR:$CODEX_DIR:$PATH" \
    KITGEN_CODEX_BIN="$CODEX_BIN" \
    NODE_PATH="${NODE_PATH:-$HOME_DIR/tools/node_modules}" \
    PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-$HOME_DIR/tools/playwright-browsers}" \
    "$NODE" "$SOURCE/agent/server.mjs" \
    --workspace "$WORKSPACE" --port "$PORT" --origin "$ORIGIN" --app-root "$SOURCE/app"
}
health() {
  curl -fsS -H 'X-KitGen-Client: 1' -H "Origin: $ORIGIN" "http://127.0.0.1:$PORT/health"
}
# Lấy một field CHUỖI của /health. Payload do JSON.stringify sinh ra (không khoảng trắng,
# không xuống dòng) nên sed đủ dùng — và không kéo thêm python3 vào đường khởi động.
# `"runtimeVersion":null` (agent chạy từ source) cố ý KHÔNG khớp ⇒ trả rỗng = "không biết".
json_field() { sed -n 's/.*"'"$1"'":"\([^"]*\)".*/\1/p' | head -n 1; }
running_runtime_version() { health 2>/dev/null | json_field runtimeVersion || true; }
installed_runtime_version() { cat "$SOURCE/VERSION" 2>/dev/null || true; }

# ─────────────────────────────────────────────────────────────────────────────
# "ĐÃ KHỞI ĐỘNG" PHẢI CÓ NGHĨA LÀ "ĐANG CHẠY BẢN VỪA CÀI" (BACKLOG #20).
#
# Sự cố 14/08 trên máy chủ SP: update cài xong, symlink `current` đã trỏ 2.1.20, nhưng
# TIẾN TRÌNH agent vẫn là bản cũ (uptime không đổi). Mọi health check đời cũ chỉ hỏi
# "có ai trả lời ở cổng $PORT không" — tiến trình CŨ trả lời được ⇒ cả installer lẫn UI
# đều tưởng xong. Từ đây, câu hỏi đúng là "ai đang trả lời": so `runtimeVersion` của
# /health với VERSION của bản mà `current` đang trỏ tới.
#
# HÀM NÀY CỐ Ý KHÔNG BAO GIỜ TRẢ MÃ LỖI. installer đời 2.1.20 hiểu `kitgen start` thất
# bại là "launchd hỏng" và sẽ `nohup kitgen run` thêm MỘT agent thứ hai — hai agent
# tranh nhau cổng còn tệ hơn một agent cũ. Thất bại ở đây nói bằng stderr (installer
# đang chép stderr của lệnh này vào ~/.kitgen/install.log) chứ không bằng exit code.
#
# Ba ca "không kết luận được" đều PHẢI im lặng đi qua: không có curl, agent chưa kịp
# lên, hoặc agent đời cũ không có field `runtimeVersion`.
# ─────────────────────────────────────────────────────────────────────────────
wait_runtime_version() {
  want="$1"; attempts="${2:-15}"; seen=""
  while [ "$attempts" -gt 0 ]; do
    seen="$(running_runtime_version)"
    if [ "$seen" = "$want" ]; then return 0; fi
    attempts=$((attempts - 1))
    if [ "$attempts" -gt 0 ]; then sleep 1; fi
  done
  [ -n "$seen" ] || return 2   # 2 = không đọc được version ⇒ không kết tội ai
  return 1
}
verify_running_current() {
  want="$(installed_runtime_version)"
  [ -n "$want" ] || return 0
  wait_runtime_version "$want" 15 && return 0
  [ "$?" -eq 1 ] || return 0
  echo "KitGen: dịch vụ vẫn đang chạy bản $(running_runtime_version) sau khi khởi động lại (đã cài $want) — thử dừng hẳn rồi bật lại." >&2
  if [ "$(uname -s)" = Darwin ]; then
    launchctl kill KILL "gui/$(id -u)/com.kitgen.agent" 2>/dev/null || true
    sleep 1
    macos_start >/dev/null 2>&1 || true
  elif command -v systemctl >/dev/null 2>&1; then
    systemctl --user restart kitgen-agent >/dev/null 2>&1 || true
  else
    pkill -f "$SOURCE/agent/server.mjs" 2>/dev/null || true
    sleep 1
    nohup "$0" run >>"$HOME_DIR/agent.log" 2>&1 &
  fi
  wait_runtime_version "$want" 20 && return 0
  [ "$?" -eq 1 ] || return 0
  echo "KitGen: KHÔNG khởi động lại được dịch vụ. Bản $want đã cài xong nhưng chưa chạy." >&2
  echo "KitGen: chạy tay lệnh này rồi tải lại trang:  $HOME_DIR/bin/kitgen restart" >&2
  return 0
}
macos_start() {
  domain="gui/$(id -u)"
  service="$domain/com.kitgen.agent"
  plist="$HOME/Library/LaunchAgents/com.kitgen.agent.plist"
  if ! launchctl print "$service" >/dev/null 2>&1; then
    [ -f "$plist" ] || { echo "KitGen LaunchAgent is missing: $plist" >&2; return 1; }
    attempt=1
    while ! launchctl bootstrap "$domain" "$plist"; do
      launchctl print "$service" >/dev/null 2>&1 && break
      [ "$attempt" -lt 5 ] || return 1
      attempt=$((attempt + 1))
      sleep 1
    done
  fi
  launchctl print "$service" >/dev/null 2>&1 || return 1
  launchctl kickstart -k "$service"
}
case "${1:-help}" in
  run) agent_cmd ;;
  start)
    if [ "$(uname -s)" = Darwin ]; then macos_start
    elif command -v systemctl >/dev/null 2>&1; then systemctl --user start kitgen-agent
    else nohup "$0" run >>"$HOME_DIR/agent.log" 2>&1 & fi
    # Khởi động XONG chưa đủ: phải đúng bản đang cài (xem verify_running_current).
    verify_running_current ;;
  stop)
    if [ "$(uname -s)" = Darwin ]; then launchctl kill TERM "gui/$(id -u)/com.kitgen.agent" 2>/dev/null || true
    elif command -v systemctl >/dev/null 2>&1; then systemctl --user stop kitgen-agent
    else pkill -f "$SOURCE/agent/server.mjs" 2>/dev/null || true; fi ;;
  restart) "$0" stop; sleep 1; "$0" start ;;
  status) health || { echo; echo "KitGen agent is not responding on port $PORT" >&2; exit 1; } ;;
  doctor) curl -fsS -H 'X-KitGen-Client: 1' -H "Origin: $ORIGIN" "http://127.0.0.1:$PORT/api/doctor?refresh=1" ;;
  logs) tail -n "${2:-100}" "$HOME_DIR/agent.log" ;;
  open) open "http://127.0.0.1:$PORT/app/" 2>/dev/null || xdg-open "http://127.0.0.1:$PORT/app/" ;;
  update) shift; exec "$HOME_DIR/install.sh" --update "$@" ;;
  help|*) echo "Usage: kitgen {start|stop|restart|status|doctor|logs [n]|open|update}" ;;
esac
